# SmartCart AI - Environment Variables Reference

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/smartcart_ai

# Security / JWT
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Cloudinary (Image Uploads - optional fallback to local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Recommendation Provider (Optional LLM adapter, deterministic fallback included)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Initial Admin Bootstrap Credential (CLI only)
ADMIN_BOOTSTRAP_SECRET=bootstrap_secret_smartcart_2026
